{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper2-bounded-source-projection-input-v1",
  "title": "Paper 2 bounded source projection local input v1",
  "description": "Local-only source-facing input. It binds a frozen public full-text artifact to one complete source-native abstract without claim-directed excerpt selection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "stable_identity",
    "public_fulltext_locator",
    "retrieved_at",
    "source_language",
    "fulltext_sha256",
    "abstract_state",
    "abstract_locator",
    "abstract_text",
    "abstract_boundary_attestation"
  ],
  "properties": {
    "schema_version": {"const": "paper2-bounded-source-projection-input-v1"},
    "bundle_id": {"type": "string", "pattern": "^B[0-9]{4}$"},
    "stable_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["DOI", "ARXIV", "PMID"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "public_fulltext_locator": {"type": "string", "pattern": "^https?://", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 1},
    "source_language": {"const": "en"},
    "fulltext_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "abstract_state": {"enum": ["PRESENT", "ABSENT"]},
    "abstract_locator": {"type": ["string", "null"]},
    "abstract_text": {"type": ["string", "null"]},
    "abstract_boundary_attestation": {
      "enum": [
        "SOURCE_NATIVE_COMPLETE_ABSTRACT_VERIFIED",
        "NO_SOURCE_NATIVE_ABSTRACT_VERIFIED"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"abstract_state": {"const": "PRESENT"}}},
      "then": {
        "properties": {
          "abstract_locator": {"type": "string", "minLength": 1},
          "abstract_text": {"type": "string", "minLength": 1},
          "abstract_boundary_attestation": {"const": "SOURCE_NATIVE_COMPLETE_ABSTRACT_VERIFIED"}
        }
      }
    },
    {
      "if": {"properties": {"abstract_state": {"const": "ABSENT"}}},
      "then": {
        "properties": {
          "abstract_locator": {"type": "null"},
          "abstract_text": {"type": "null"},
          "abstract_boundary_attestation": {"const": "NO_SOURCE_NATIVE_ABSTRACT_VERIFIED"}
        }
      }
    }
  ]
}
