  "supersedes": {
    "paper2-sampling-v1": "primary work-selection rule only"
  },
  "inherits_from_v1": [
    "Top50 calibration exclusion",
    "max 3 selected claims per work",
    "explicit denominator discipline",
    "paper-level dependence and 2000-replicate cluster bootstrap",
    "pipeline-failure versus scientific-residual separation",
    "J=100 null-control schedule under #140",
    "no result-dependent stopping or expansion"
  ],
  "target_surface": "temporally stratified citation-ranked high-impact cognitive-capacity literature under frozen retrieval-v1 and eligibility-v1.1 semantics",
  "retrieval_authority": {
    "provider": "OpenAlex",
    "retrieval_schema": "paper2-retrieval-v1",
    "counts_artifact_sha256": "9b1d59c816a547d053fb5a34d7bd6da549d12bb43814b11095f863b4103ef40e",
    "union_oql_utf8_sha256": "35f6a79454cb8a279cc397cfa1eea2c07cca15141744060cce3cf4454bad63b6",
    "union_oql_jq_r_sha256": "5156ddf574e15f4b82f090dd8bf870775a31c50f292a48fd374967b4776157ab",
    "union_oql_jq_r_representation": "exact union_oql UTF-8 string followed by one LF byte, matching jq -r line output",
    "historical_N_frame": 31550631,
    "full_manifest_required": false,
    "provider_state_at_sampling_must_be_recorded": true,
    "era_count_measurement": {
      "method": "one_shot_bucket_counts_with_union_before_after_bracket",
      "transport_attempts_per_query": 1,
      "cursor_paging_used": false,
      "meta_count_equality_across_requests_required": false,
      "reason": "OpenAlex OQL counts are live and may drift across requests; record and bracket drift rather than require pagewise equality",
      "measurement_buckets_are_final_sampling_eras": false
    }
  },
  "primary_work_target": {
    "K": 1000,
    "minimum_per_included_era": 50,
    "weight": "sqrt(N_d)",
    "formula": "k_d = 50 + Hamilton((1000 - 50*D) * sqrt(N_d) / sum_j sqrt(N_j))",
    "integer_apportionment": "hamilton_largest_remainder",
    "exact_remainder_tie_break": "declared frozen era order",
    "sum_k_d_must_equal_K": true,
    "frozen_era_allocation": {
      "PRE_1950": 68,
      "1950-1959": 65,
      "1960-1969": 71,
      "1970-1979": 81,
      "1980-1989": 90,
      "1990-1999": 106,
      "2000-2009": 137,
      "2010-2019": 188,
      "2020-2026": 194
    }
  },
  "within_era_ranking": {
    "ranking_contract": "research/paper2/sampling_v2_ranking_sourcewise.json",
    "primary_sort": "cited_by_count descending",
    "tie_break": "canonical OpenAlex Work ID ascending after complete citation-count tie closure",
    "eligibility": "paper2-eligibility-v1.1 (#133)",
    "quota_fill": "screen from rank 1 downward until k_d INCLUDE works",
    "candidate_ladder_multiplier": 5,
    "formal_model_required": false,
    "citation_is_epistemic_weight": false
  },
  "screening_states": [
    "INCLUDE",
    "EXCLUDE",
    "ELIGIBILITY_UNCERTAIN",
    "SOURCE_INACCESSIBLE",
    "CALIBRATION_EXCLUDED"
  ],
  "reserve": {
    "prefreeze_screening_continuation": "continue the same frozen within-era ranking until first k_d INCLUDE works or frozen ladder exhaustion",
    "ad_hoc_replacement_forbidden": true,
    "post_freeze_replacement_limit": 0,
    "post_freeze_replacement_policy": "NONE",
    "failure_after_freeze": "retain extraction/IR/decomposition failure in explicit denominator/failure taxonomy; do not replace the work"
  },
  "era_policy": {
    "status": "FROZEN_PREOUTCOME",
    "authority_artifact": "research/paper2/sampling_v2_era_freeze.json",
    "study_publication_year_cutoff": 2026,
    "included_eras_in_order": [
      "PRE_1950",
      "1950-1959",
      "1960-1969",
      "1970-1979",
      "1980-1989",
      "1990-1999",
      "2000-2009",
      "2010-2019",
      "2020-2026"
    ],
    "pre_1950": "aggregate all known publication years <= 1949 into one historical anchor stratum",
    "partial_current_decade": "2020-2026 inclusive as a partial contemporary stratum",
    "unknown_year": "exclude from primary temporal sampling as unstratifiable metadata; not a scientific eligibility exclusion",
    "post_2026": "exclude from primary temporal sampling as after study publication-year cutoff; not a scientific eligibility exclusion",
    "silent_year_exclusion_forbidden": true
  },
  "sensitivity": {
    "candidate": "equal quota per frozen era",
    "primary_replacement_after_outcomes_forbidden": true
  },
  "real_corpus_selection_authorized": false,
  "anti_circularity": {
    "allowed_sampling_inputs": [
      "frozen retrieval-v1 semantics",
      "publication year",
      "citation count",
      "canonical bibliographic identity",
      "frozen eligibility-v1.1 disposition",
      "pre-outcome source-access and operational cost information"
    ],
    "forbidden_sampling_inputs": [
      "held-out ClaimIR content",
      "decomposition PASS or RESIDUAL",
      "real/null coverage",
      "basis-specific ease of reconstruction"
    ]
  }
