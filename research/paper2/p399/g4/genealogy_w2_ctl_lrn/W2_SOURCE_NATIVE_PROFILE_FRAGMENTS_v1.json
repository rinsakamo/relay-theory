        "central_claim_boundary": "Behavioral joint choice/RT model; task manipulations are World/input structure and no neural association is promoted to a mechanistic controller.",
        "paper_specific_operators": [
          "CTL-01:context-conditioned-policy-posterior",
          "CTL-01:context-specific-policy-prior-learning",
          "CTL-01:independent-mcmc-policy-sampler",
          "CTL-01:dirichlet-precision-stopping-rt"
        ],
        "decisive_equations_or_updates": [
          "p(pi|c,R,alpha) is proportional to p(R|pi,c) times the context-specific adaptive policy prior p(pi|c,alpha)",
          "policy likelihood is evaluated through the context-conditioned MDP/variational predicted-free-energy machinery",
          "Bayesian independent MCMC samples policies and a precision/entropy stopping criterion controls the sample count used for RT",
          "reaction time is derived from number of samples plus non-decision time"
        ],
        "variants_and_comparators": [
          "value-only versus automatism+value",
          "flanker and task-switch mappings",
          "DDM is an explicit comparator boundary, not an asserted identity"
        ],
