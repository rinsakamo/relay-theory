{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post-source-native, pre-D locked Grammar role obligation bridge v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_token",
    "source_reference_canonical_sha256",
    "bridge_frozen_before_D",
    "status",
    "assessor_disclosure",
    "variants"
  ],
  "properties": {
    "schema_version": {
      "const": "G3_ROLE_BRIDGE_V1"
    },
    "paper_token": {
      "type": "string"
    },
    "source_reference_canonical_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bridge_frozen_before_D": {
      "const": true
    },
    "status": {
      "const": "LOCKED"
    },
    "assessor_disclosure": {
      "enum": [
        "SEPARATE_BRIDGE_ASSESSOR",
        "SAME_ASSESSOR_PROCEDURALLY_SEPARATE",
        "PRIOR_EXPOSURE_DISCLOSED"
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "role_obligations",
          "role_gaps"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "role_obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_atom_ids",
                "role",
                "justification",
                "source_locator"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "source_atom_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "role": {
                  "enum": [
                    "Pi",
                    "X",
                    "C",
                    "Q",
                    "P_in",
                    "P_out",
                    "K",
                    "T",
                    "rho/O"
                  ]
                },
                "justification": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "role_gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_atom_ids",
                "diagnostic_layer",
                "explanation"
              ],
              "properties": {
                "source_atom_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "diagnostic_layer": {
                  "enum": [
                    "L_sys",
                    "L_claim",
                    "L_ctx",
                    "L_formal",
                    "SOURCE_UNDERSPECIFIED"
                  ]
                },
                "explanation": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
