{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G3 source-native reference object v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_token",
    "source",
    "assessor",
    "variants",
    "original_limitations",
    "freeze_state"
  ],
  "properties": {
    "schema_version": {
      "const": "G3_REFERENCE_V1"
    },
    "paper_token": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_kind",
        "edition",
        "source_fingerprint",
        "correction_review",
        "complete_verified"
      ],
      "properties": {
        "primary_kind": {
          "enum": [
            "PUBLISHER_ORIGINAL_PDF",
            "PUBLISHER_COMPLETE_ORIGINAL_HTML"
          ]
        },
        "edition": {
          "type": "string"
        },
        "source_fingerprint": {
          "type": "string",
          "minLength": 12
        },
        "correction_review": {
          "type": "string"
        },
        "complete_verified": {
          "const": true
        },
        "pre_a_analytic_exception": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assessor": {
      "type": "object",
      "required": [
        "assessor_token",
        "access_to_full_primary",
        "grammar_outcomes_inaccessible",
        "independence_disclosure"
      ],
      "properties": {
        "assessor_token": {
          "type": "string"
        },
        "access_to_full_primary": {
          "const": true
        },
        "grammar_outcomes_inaccessible": {
          "const": true
        },
        "independence_disclosure": {
          "enum": [
            "INDEPENDENT_R2_COMPLETED",
            "SINGLE_REFERENCE_UNVALIDATED",
            "PRIOR_EXPOSURE_DISCLOSED"
          ]
        },
        "r2_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessor_token",
            "full_original_read",
            "blind_to_D_E",
            "separate_actor_receipt_sha256"
          ],
          "properties": {
            "assessor_token": {
              "type": "string",
              "minLength": 1
            },
            "full_original_read": {
              "const": true
            },
            "blind_to_D_E": {
              "const": true
            },
            "separate_actor_receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "independence_disclosure": {
                "const": "INDEPENDENT_R2_COMPLETED"
              }
            }
          },
          "then": {
            "required": [
              "r2_attestation"
            ]
          }
        }
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "native_name_vault_ref",
          "nodes",
          "edges",
          "temporal",
          "restrictions",
          "boundaries",
          "distinctions",
          "native_coordination",
          "included"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "native_name_vault_ref": {
            "type": "string"
          },
          "included": {
            "type": "boolean"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "alternative_locators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical",
                "from",
                "to",
                "source_type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "source_type": {
                  "type": "string",
                  "minLength": 1
                },
                "guard": {
                  "type": "string"
                },
                "alternative_locators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "temporal": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "alternative_locators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "alternative_locators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "alternative_locators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "distinctions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "alternative_locators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "native_coordination": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "alternative_locators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "source_comparisons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical",
                "contrast_kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "contrast_kind": {
                  "enum": [
                    "TYPE_INTERFACE_CONTRAST",
                    "HISTORY_DEPENDENCE_CONTRAST",
                    "OTHER_SOURCE_DEFINED"
                  ]
                },
                "alternative_locators": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "original_limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_locator",
          "witness",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "witness": {
            "type": "string",
            "minLength": 1
          },
          "critical": {
            "type": "boolean"
          },
          "meaning": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      }
    },
    "excluded_quantitative_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "source_locator",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source_locator": {
            "type": "string"
          },
          "status": {
            "enum": [
              "EXCLUDED_SOURCE_UNRESOLVED",
              "EXCLUDED_PREDECLARED_OUT_OF_SCOPE"
            ]
          }
        }
      }
    },
    "freeze_state": {
      "enum": [
        "LOCKED",
        "WORKING"
      ]
    }
  }
}
