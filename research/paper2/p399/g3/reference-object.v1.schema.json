{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G3 source-native reference object v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_token",
    "source",
    "assessor",
    "variants",
    "original_limitations",
    "freeze_state"
  ],
  "properties": {
    "schema_version": {
      "const": "G3_REFERENCE_V1"
    },
    "paper_token": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_kind",
        "edition",
        "source_fingerprint",
        "correction_review",
        "complete_verified"
      ],
      "properties": {
        "primary_kind": {
          "enum": [
            "PUBLISHER_ORIGINAL_PDF",
            "PUBLISHER_COMPLETE_ORIGINAL_HTML"
          ]
        },
        "edition": {
          "type": "string"
        },
        "source_fingerprint": {
          "type": "string",
          "minLength": 12
        },
        "correction_review": {
          "type": "string"
        },
        "complete_verified": {
          "const": true
        },
        "pre_a_analytic_exception": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assessor": {
      "type": "object",
      "required": [
        "assessor_token",
        "access_to_full_primary",
        "grammar_outcomes_inaccessible",
        "independence_disclosure"
      ],
      "properties": {
        "assessor_token": {
          "type": "string"
        },
        "access_to_full_primary": {
          "const": true
        },
        "grammar_outcomes_inaccessible": {
          "const": true
        },
        "independence_disclosure": {
          "enum": [
            "INDEPENDENT_R2_COMPLETED",
            "SINGLE_REFERENCE_UNVALIDATED",
            "PRIOR_EXPOSURE_DISCLOSED"
          ]
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "native_name_vault_ref",
          "nodes",
          "edges",
          "temporal",
          "restrictions",
          "boundaries",
          "distinctions",
          "native_coordination",
          "included"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "native_name_vault_ref": {
            "type": "string"
          },
          "included": {
            "type": "boolean"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "source_locator",
                    "witness",
                    "critical"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "witness": {
                      "type": "string",
                      "minLength": 1
                    },
                    "critical": {
                      "type": "boolean"
                    },
                    "meaning": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "source_type": {
                      "type": "string"
                    },
                    "guard": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "source_type"
                  ]
                }
              ]
            }
          },
          "temporal": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          },
          "distinctions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          },
          "native_coordination": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_locator",
                "witness",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                },
                "critical": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "original_limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_locator",
          "witness",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "witness": {
            "type": "string",
            "minLength": 1
          },
          "critical": {
            "type": "boolean"
          },
          "meaning": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      }
    },
    "excluded_quantitative_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "source_locator",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source_locator": {
            "type": "string"
          },
          "status": {
            "enum": [
              "EXCLUDED_SOURCE_UNRESOLVED",
              "EXCLUDED_PREDECLARED_OUT_OF_SCOPE"
            ]
          }
        }
      }
    },
    "freeze_state": {
      "enum": [
        "LOCKED",
        "WORKING"
      ]
    }
  }
}
