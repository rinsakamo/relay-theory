    },
    "MEM": {
      "label": "Memory",
      "kind": "corpus_component",
      "reads": ["durable.memory", "present"],
      "writes": ["durable.memory", "present.retrieval_projection"],
      "operators": ["memory_retain", "memory_retrieve"],
      "criteria": ["retrieval_relevance", "retention_admissibility"],
      "ports": ["memory_write_in", "retrieval_out"],
      "triggers": ["governed_retention", "retrieval_request"],
      "dependencies": [],
      "disable_semantics": "stop memory routes; do not delete retained memory",
      "relayself_status": "PARTIAL_EXISTING"
    },
    "PRD": {
      "label": "Prediction",
      "kind": "corpus_component",
      "reads": ["present", "durable.model_or_predictive_structure", "external_evidence"],
      "writes": ["operator_local.rollout", "present.prediction"],
      "operators": ["predict", "rollout", "value_projection"],
      "criteria": ["expected_value", "evidence", "prediction_error"],
      "ports": ["state_or_query_in", "prediction_or_value_out"],
      "triggers": ["explicit_prediction_request", "planning_request", "control_uncertainty"],
      "dependencies": [],
      "disable_semantics": "stop predictive routes; preserve learned model state",
      "relayself_status": "MODEL_SPECIFIC_ONLY"
    },
    "SKL": {
      "label": "Skill",
      "kind": "corpus_component",
      "reads": ["execution.intent", "present", "external_evidence", "durable.skill_structure"],
      "writes": ["execution.skill", "execution.action"],
      "operators": ["skill_select", "skill_step", "action_propose"],
      "criteria": ["applicability", "progress", "success_failure"],
      "ports": ["skill_feedback_in", "action_proposal_out"],
      "triggers": ["current_intent", "skill_feedback", "decision_epoch"],
      "dependencies": ["CTL"],
      "disable_semantics": "do not start new Skill execution; preserve definitions and existing governed state",
      "relayself_status": "PARTIAL_EXISTING"
    },
    "PLAN": {
      "label": "Planning",
      "kind": "derived_application",
      "reads": ["present", "durable.model_or_predictive_structure"],
      "writes": ["operator_local.planner_state", "present.plan_candidate"],
      "operators": ["iterative_rollout", "search_expand", "plan_select"],
      "criteria": ["goal_value", "cost", "constraint"],
      "ports": ["planning_problem_in", "plan_candidate_out"],
      "triggers": ["explicit_planning_request", "control_uncertainty"],
      "dependencies": ["PRD"],
      "disable_semantics": "stop internal rollout/search; no effect on retained predictive structure",
      "relayself_status": "DESIGN_GAP_GENERAL"
    },
    "HABIT": {
      "label": "Habit",
      "kind": "derived_application",
      "reads": ["durable.habit_structure", "present"],
      "writes": ["present.action_or_skill_candidate"],
      "operators": ["direct_policy_or_cached_mapping"],
      "criteria": ["applicability", "confidence", "viability"],
      "ports": ["cue_in", "candidate_out"],
      "triggers": ["compatible_cue"],
      "dependencies": ["CTL"],
      "disable_semantics": "bypass habit route and use ordinary control/cognition; preserve retained mapping",
      "relayself_status": "OFF_BY_DEFAULT_REQUIRES_QUALIFICATION"
    },
    "TALK": {
      "label": "Talk",
      "kind": "derived_application",
      "reads": ["present", "durable.memory", "durable.identity"],
      "writes": ["present.expression"],
      "operators": ["open_cognition", "expression_render"],
