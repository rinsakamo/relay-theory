  "capabilities": {
    "ATT": {
      "label": "Attention",
      "kind": "corpus_component",
      "reads": ["external_evidence", "present"],
      "writes": ["present.attention_projection"],
      "operators": ["attention_gate", "priority_normalize", "route_projection"],
      "criteria": ["relevance", "priority"],
      "ports": ["observation_in", "selected_projection_out"],
      "triggers": ["admitted_observation", "present_reprojection"],
      "dependencies": [],
