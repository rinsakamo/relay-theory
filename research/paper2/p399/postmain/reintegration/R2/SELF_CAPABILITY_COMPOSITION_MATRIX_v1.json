      "relayself_status": "DESIGN_GAP_GENERAL"
    },
    "BLF": {
      "label": "Belief",
      "kind": "corpus_component",
      "reads": ["external_evidence", "durable.belief", "present"],
      "writes": ["durable.belief_or_present_belief"],
