      "triggers": ["novel_input", "explicit_query", "learning_admission"],
      "dependencies": [],
      "disable_semantics": "stop composition/classification routes; preserve retained representation",
      "relayself_status": "DESIGN_GAP_GENERAL"
    },
    "CTL": {
      "label": "Control",
      "kind": "corpus_component",
      "reads": ["present", "execution.intent", "execution.skill", "external_evidence"],
      "writes": ["execution.intent_or_skill_or_action_transition"],
      "operators": ["control_select", "action_propose"],
      "criteria": ["value", "viability", "admissibility"],
      "ports": ["boundary_state_in", "action_proposal_out"],
      "triggers": ["decision_epoch", "reconsideration", "skill_feedback"],
      "dependencies": [],
      "disable_semantics": "no new embodied control path; existing lifecycle state remains intact",
      "relayself_status": "PARTIAL_EXISTING"
    },
    "LRN": {
      "label": "Learning",
      "kind": "corpus_component",
      "reads": ["external_evidence", "durable.learnable_structure", "execution"],
      "writes": ["durable.learnable_structure"],
