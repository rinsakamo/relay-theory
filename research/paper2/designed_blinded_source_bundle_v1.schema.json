{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rinsakamo/relay-theory/blob/main/research/paper2/designed_blinded_source_bundle_v1.schema.json",
  "title": "Paper 2 designed blinded source bundle v1",
  "description": "Post-focus extraction-visible bytes for one frozen designed Paper 2 source. This <=3-span surface is produced only after the later frozen focus-selection stage; source capture itself uses paper2-designed-masked-source-surface-v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "source_language",
    "source_spans"
  ],
  "properties": {
    "schema_version": {
      "const": "paper2-designed-blinded-source-bundle-v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^B[0-9]{4}$"
    },
    "source_language": {
      "type": "string",
      "minLength": 2
    },
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "span_id",
          "text"
        ],
        "properties": {
          "span_id": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
