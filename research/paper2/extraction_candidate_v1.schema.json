{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rinsakamo/relay-theory/blob/main/research/paper2/extraction_candidate_v1.schema.json",
  "title": "Paper 2 extraction candidate v1",
  "description": "Extractor-visible result before provenance and extraction metadata are restored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "claim_core"
  ],
  "properties": {
    "schema_version": {
      "const": "paper2-extraction-candidate-v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^B[0-9]{4}$"
    },
    "claim_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_type",
        "modality",
        "scope",
        "nodes",
        "relations"
      ],
      "properties": {
        "claim_type": {
          "enum": [
            "relation",
            "criterion",
            "mapping",
            "comparison",
            "counterfactual",
            "definition",
            "constraint",
            "other"
          ]
        },
        "modality": {
          "enum": [
            "descriptive",
            "necessary",
            "sufficient",
            "probabilistic",
            "definitional",
            "counterfactual",
            "comparative",
            "other"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conditions",
            "population",
            "substrate",
            "task",
            "temporal_scope"
          ],
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "population": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "substrate": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "task": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "temporal_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role",
              "description",
              "source_span_ids",
              "grounding"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "role": {
                "enum": [
                  "condition",
                  "available_information",
                  "state_or_structure",
                  "intervention",
                  "response_or_outcome",
                  "criterion",
                  "probe",
                  "partition",
                  "other"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "source_span_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^s[0-9]+$"
                }
              },
              "grounding": {
                "enum": [
                  "explicit",
                  "normalized"
                ]
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "arguments",
              "description",
              "source_span_ids",
              "grounding"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "kind": {
                "enum": [
                  "equals",
                  "differs",
                  "depends_on",
                  "changes",
                  "predicts",
                  "maps_to",
                  "satisfies",
                  "distinguishes",
                  "precedes",
                  "constrains",
                  "equivalent",
                  "other"
                ]
              },
              "arguments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "source_span_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^s[0-9]+$"
                }
              },
              "grounding": {
                "enum": [
                  "explicit",
                  "normalized"
                ]
              }
            }
          }
        }
      }
    }
  }
}
