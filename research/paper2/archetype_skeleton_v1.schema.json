{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rinsakamo/relay-theory/blob/main/research/paper2/basis_structural_skeleton_v1.schema.json",
  "title": "Paper 2 basis-structural skeleton v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_phi_version",
    "basis_version",
    "active_axes",
    "nodes",
    "edges",
    "temporal",
    "controls"
  ],
  "properties": {
    "schema_version": {"const": "paper2-basis-structural-skeleton-v1"},
    "source_phi_version": {"const": "paper2-phi-object-v1"},
    "basis_version": {"const": "paper2-working-basis-v1"},
    "active_axes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["S", "Pi", "K", "O", "T", "C", "Q", "P"]}
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["space", "role", "required", "axis"],
        "properties": {
          "space": {"const": "basis_coordinate"},
          "role": {"type": "string"},
          "required": {"type": "boolean"},
          "axis": {
            "oneOf": [
              {"enum": ["S", "Pi", "K", "O", "T", "C", "Q", "P"]},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "kind",
          "ordered_arguments",
          "arguments",
          "conditional_on",
          "temporal_direction"
        ],
        "properties": {
          "family": {"enum": ["basis_relation", "temporal_order"]},
          "kind": {"type": "string"},
          "ordered_arguments": {"type": "boolean"},
          "arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "conditional_on": {"type": "array", "items": {"type": "string"}},
          "temporal_direction": {"type": "string"}
        }
      }
    },
    "temporal": {"type": "object"},
    "controls": {"type": "object"}
  }
}
